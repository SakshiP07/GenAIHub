pipeline {
    agent any

    environment {
        PROJECT_NAME = 'genaihub'
        FRONTEND_IMAGE = "${PROJECT_NAME}-frontend"
        BACKEND_IMAGE = "${PROJECT_NAME}-backend"
    }

    stages {

        stage('Build') {
            steps {
                echo 'Build stage completed'
            }
        }

        stage('Test') {
            steps {
                echo 'Tests skipped for demo project'
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Docker images already built'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment stage completed'
            }
        }

    }

    post {
        success {
            echo 'GenAIHub pipeline completed successfully.'
        }

        failure {
            echo 'GenAIHub pipeline failed.'
        }
    }
}